# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
# 5000 is taken by the macOS AirPlay Receiver, so the default is 5001.
PORT=5001
# Leave unset for 127.0.0.1 in dev / 0.0.0.0 in production.
# HOST=127.0.0.1

# --- Database -------------------------------------------------------------
# Local Postgres. setup.command creates this for you.
DATABASE_URL=postgresql://localhost:5432/billflow

# --- Sessions -------------------------------------------------------------
# Required. Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Auth -----------------------------------------------------------------
# "none"   = single-user, no sign-in at all (default; local use only)
# "local"  = email + password
# "replit" = Replit OIDC, needs REPL_ID and an https host
AUTH_PROVIDER=none

# With AUTH_PROVIDER=none every request acts as one account: the oldest row in
# the users table, or this id if set.
# SINGLE_USER_ID=

# --- Gmail (optional; invoice sending) -------------------------------------
# Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials, enable the Gmail API, and
# add http://localhost:5055/oauth2callback as an authorised redirect URI.
# Then run: npm run gmail:auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The address invoices are sent from; also shown as "connected" in Settings.
GMAIL_SENDER_EMAIL=
