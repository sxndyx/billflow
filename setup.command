#!/bin/bash
# BillFlow setup. Double-click this file in Finder, or run ./setup.command
#
# Installs what is missing, creates the database, generates a config file and
# builds the app. Safe to run more than once: it skips anything already done
# and never overwrites an existing .env.
set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")" || exit 1
PROJECT_DIR="$(pwd)"

BOLD=$'\033[1m'; DIM=$'\033[2m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; OFF=$'\033[0m'
step() { printf '\n%s==>%s %s%s\n' "$BOLD" "$OFF" "$BOLD" "$1$OFF"; }
ok()   { printf '    %s✓%s %s\n' "$GREEN" "$OFF" "$1"; }
note() { printf '    %s%s%s\n' "$DIM" "$1" "$OFF"; }
warn() { printf '    %s!%s %s\n' "$YELLOW" "$OFF" "$1"; }
die()  { printf '\n%serror:%s %s\n\n' "$RED" "$OFF" "$1"; read -r -p "Press Return to close. "; exit 1; }

DB_NAME="${BILLFLOW_DB:-billflow}"
PORT="${BILLFLOW_PORT:-5001}"
PG_FORMULA="postgresql@16"

printf '%s\n' "$BOLD"
cat <<'BANNER'
  ____  _ _ _ ____ _
 | __ )(_) | |  ___| | _____      __
 |  _ \| | | | |_  | |/ _ \ \ /\ / /
 | |_) | | | |  _| | | (_) \ V  V /
 |____/|_|_|_|_|   |_|\___/ \_/\_/
BANNER
printf '%s  Time tracking and invoicing, on your own Mac.\n' "$OFF"

[ "$(uname -s)" = "Darwin" ] || die "This installer is for macOS. On Linux, see the manual steps in README.md."

# ---------------------------------------------------------------- Homebrew --
step "Checking Homebrew"
if command -v brew >/dev/null 2>&1; then
  ok "found at $(command -v brew)"
else
  warn "Homebrew is not installed, and BillFlow needs it for Node and Postgres."
  note "Install it by pasting this into Terminal, then run this installer again:"
  printf '\n      /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"\n'
  die "Homebrew required."
fi
BREW_PREFIX="$(brew --prefix)"

# -------------------------------------------------------------------- Node --
step "Checking Node.js"
if command -v node >/dev/null 2>&1; then
  NODE_MAJOR="$(node -v | sed 's/^v//;s/\..*//')"
  if [ "$NODE_MAJOR" -lt 20 ]; then
    die "Node $(node -v) is too old. BillFlow needs Node 20 or newer."
  fi
  ok "Node $(node -v)"
else
  warn "Node.js is not installed."
  read -r -p "    Install it with Homebrew now? [Y/n] " reply
  case "${reply:-Y}" in
    [Nn]*) die "Node 20 or newer is required." ;;
  esac
  brew install node || die "Could not install Node."
  ok "Node $(node -v)"
fi

# ---------------------------------------------------------------- Postgres --
step "Checking PostgreSQL"
if ! brew list --formula 2>/dev/null | grep -q "^${PG_FORMULA}$"; then
  warn "PostgreSQL is not installed."
  read -r -p "    Install ${PG_FORMULA} with Homebrew now? [Y/n] " reply
  case "${reply:-Y}" in
    [Nn]*) die "PostgreSQL is required. See README.md to point BillFlow at an existing server." ;;
  esac
  brew install "$PG_FORMULA" || die "Could not install PostgreSQL."
fi
export PATH="$BREW_PREFIX/opt/$PG_FORMULA/bin:$PATH"
ok "$PG_FORMULA installed"

if ! pg_isready -q 2>/dev/null; then
  note "starting PostgreSQL"
  brew services start "$PG_FORMULA" >/dev/null 2>&1
  for _ in $(seq 1 30); do pg_isready -q 2>/dev/null && break; sleep 1; done
fi
pg_isready -q 2>/dev/null || die "PostgreSQL would not start. Try: brew services start $PG_FORMULA"
ok "PostgreSQL is running"

# ---------------------------------------------------------------- Database --
step "Setting up the database"
if psql -lqt 2>/dev/null | cut -d'|' -f1 | grep -qw "$DB_NAME"; then
  ok "database \"$DB_NAME\" already exists, keeping it"
else
  createdb "$DB_NAME" || die "Could not create the database \"$DB_NAME\"."
  ok "created database \"$DB_NAME\""
fi

# ------------------------------------------------------------------ Config --
step "Writing configuration"
if [ -f .env ]; then
  ok ".env already exists, leaving it alone"
else
  # A free port, so a busy 5001 does not produce a confusing failure later.
  while lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; do
    note "port $PORT is in use, trying $((PORT + 1))"
    PORT=$((PORT + 1))
  done

  cat > .env <<ENVFILE
# Generated by setup.command on $(date '+%Y-%m-%d')
PORT=$PORT
DATABASE_URL=postgresql://localhost:5432/$DB_NAME
SESSION_SECRET=$(openssl rand -base64 32)
AUTH_PROVIDER=none
ENVFILE
  ok "wrote .env (port $PORT, database $DB_NAME)"
fi
PORT="$(grep -E '^PORT=' .env | head -1 | cut -d= -f2 | tr -d '[:space:]')"
PORT="${PORT:-5001}"

# ------------------------------------------------------------ Dependencies --
step "Installing dependencies"
note "this takes a minute the first time"
npm install --silent || die "npm install failed."
ok "dependencies installed"

step "Creating database tables"
npm run --silent db:push >/dev/null 2>&1 || die "Could not create the tables. Is PostgreSQL running?"
ok "tables ready"

step "Building the app"
npm run --silent build >/dev/null 2>&1 || die "Build failed. Run 'npm run build' to see why."
ok "built"

# --------------------------------------------------------------- Mac app ----
step "Installing the Mac app"
read -r -p "    Add BillFlow to your Applications folder? [Y/n] " reply
case "${reply:-Y}" in
  [Nn]*) note "skipped. You can run it any time with: npm start" ;;
  *)
    if npm run --silent app:install >/dev/null 2>&1; then
      ok "BillFlow.app installed, and the server now starts automatically"
    else
      warn "Could not install the Mac app. Run 'npm run app:install' to see why."
      note "You can still run BillFlow with: npm start"
    fi
    ;;
esac

# -------------------------------------------------------------------- Done --
printf '\n%s%s  Setup complete.%s\n\n' "$BOLD" "$GREEN" "$OFF"
printf '  Open BillFlow:   %shttp://localhost:%s%s\n' "$BOLD" "$PORT" "$OFF"
printf '  Or from Finder:  %sApplications > BillFlow%s\n' "$BOLD" "$OFF"
printf '  Start manually:  %snpm start%s\n\n' "$BOLD" "$OFF"
printf '  %sThe first time you open it, a short setup walks you through your\n' "$DIM"
printf '  business details, rates and first client.%s\n\n' "$OFF"

read -r -p "Open BillFlow now? [Y/n] " reply
case "${reply:-Y}" in
  [Nn]*) ;;
  *)
    (npm start >/dev/null 2>&1 &)
    for _ in $(seq 1 20); do
      curl -fsS -o /dev/null --max-time 2 "http://localhost:$PORT/" 2>/dev/null && break
      sleep 1
    done
    open "http://localhost:$PORT"
    ;;
esac
